# Staging environment example.
# Copy to .env.staging locally if needed. Real .env.* files remain ignored.

FF_BACKEND_TOTALS=false
FF_RECEIVABLES_STATE=false
FF_TENANT_ISOLATION=false
FF_AUDIT_TRAIL=false

APP_ENV=staging
DEBUG=true
LOG_LEVEL=debug

CORS_ALLOWED_ORIGINS=http://localhost:8787,https://staging.example.com
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_HOUR=10000

REQUEST_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=5000
