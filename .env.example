# Local development only. Copy to .dev.vars for Wrangler local dev.
# Do not commit real secrets.

APP_NAME="Homelink Finance"
APP_VERSION="2.0.0"
APP_ENV="development"
CORPID="replace-with-local-company-id"
ALLOW_DEV_SEED="true"

JWT_SECRET="replace-with-long-random-local-secret"
PW_SALT="replace-with-long-random-local-salt"
DATA_ENCRYPTION_KEY="replace-with-long-random-local-encryption-key"

# Use password hashes, never plaintext passwords, for owner/staff login.
MANAGER_PW_HASH="replace-with-manager-password-hash"
STAFF_PW_HASH="replace-with-staff-password-hash"
LOCAL_MANAGER_PASSWORD="replace-with-local-only-password-used-by-smoke-tests"
LOCAL_EMPLOYEE_ID="local-employee-id"
LOCAL_EMPLOYEE_NAME="local-employee-name"
LOCAL_EMPLOYEE_PIN="replace-with-local-only-pin-used-by-smoke-tests"

# Optional JSON account map for multi-user testing.
USER_ACCOUNTS='[]'

# TTLock integration. Use test credentials for local validation.
TTLOCK_API_ORIGIN="https://api.sciener.com"
TTLOCK_CLIENT_ID="replace-with-ttlock-client-id"
TTLOCK_CLIENT_SECRET="replace-with-ttlock-client-secret"
TTLOCK_USERNAME="replace-with-ttlock-username"
TTLOCK_PASSWORD="replace-with-ttlock-password"

# Origin controls.
ALLOWED_ORIGINS="http://127.0.0.1:8791,http://127.0.0.1:8792"
ALLOWED_HOST="homelink-finance.habibramadan888.workers.dev"
CLOUD_API_ORIGIN="https://homelink-finance.habibramadan888.workers.dev"
